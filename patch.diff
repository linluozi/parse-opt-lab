+def _parser_cache_key(format, extra_types, case_sensitive):
+    """Return a hashable, semantics-preserving cache key, or None."""
+    if not extra_types:
+        return (format, case_sensitive, None)
+    try:
+        items = tuple(sorted(extra_types.items()))
+        hash(items)
+    except TypeError:
+        return None
+    return (format, case_sensitive, items)
+
+
+@lru_cache(maxsize=_MAX_CACHED_PARSERS)
+def _cached_parser(format, case_sensitive, extra_items):
+    extra_types = dict(extra_items) if extra_items else None
+    return Parser(format, extra_types=extra_types, case_sensitive=case_sensitive)
+
+
+def parser_cache_info():
+    return _cached_parser.cache_info()
+
+
+def parser_cache_clear():
+    _cached_parser.cache_clear()
+
